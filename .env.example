APP_ENV=development
POSTGRES_DB=labchain
POSTGRES_USER=labchain
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql+psycopg://labchain:replace-with-random-password@postgres:5432/labchain
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=5242880
MAX_IMPORT_ROWS=1000
RPC_URL=http://hardhat-node:8545
CHAIN_ID=31337
CHAIN_CONFIRMATIONS=1
CONTRACT_ADDRESS=
RELAYER_PRIVATE_KEY=
CHAIN_CONFIG_PATH=/chain/local.json
OCR_ENABLED=true
OCR_LANGUAGES=["en","vi"]
DEMO_PASSWORD=
# Web access: use 0.0.0.0 to allow other machines on the same network.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=5173
